# Local dev/demo Ray image — head and worker share this image (worker
# needs the heavy deps for parsing/embedding/graph-extraction; head mostly
# coordinates, but one image is simpler to maintain than two for a
# single-host demo cluster).
#
# App code is NOT baked in here — it arrives per-job via
# JobSubmissionClient's runtime_env={"working_dir": "./"}
# (pipelines/jobs/s3_event_handler.py), so this image only needs the
# Python dependency set, not the repo itself. Only pyproject.toml is
# copied in, purely to keep the dependency list co-located with its
# source of truth instead of hand-duplicated with no reference.
FROM rayproject/ray:2.54.0-py312

# OpenDataLoader PDF's parsing engine is Java (thin Python wrapper) — no
# torch/GPU dependency, unlike Docling, which is why this replaced it.
# headless JRE only, no desktop/GUI packages.
USER root
RUN apt-get update && apt-get install -y --no-install-recommends \
    openjdk-17-jre-headless \
    && rm -rf /var/lib/apt/lists/*
USER ray

# Pre-create the volume mount point with correct ownership. Docker
# auto-creates missing bind/volume mount-point directories as root at
# mount time — without this, every fresh omnirag_ray_model_cache volume
# gets a root-owned huggingface/ dir that the non-root `ray` user can't
# write to, breaking FastEmbed's model download with a permission error.
RUN mkdir -p /home/ray/.cache/huggingface

WORKDIR /app
COPY pyproject.toml ./

# Flat pip install, not `uv sync` — this container's Python must be Ray's
# own interpreter (`ray start` expects it), and layering a uv-managed venv
# on top adds complexity a demo-scale single-host cluster doesn't need.
# List mirrors pyproject.toml's [ingestion] + [ray] groups, plus the
# minimal [api]-group pieces main.py's imports touch (config/LLM factory).
RUN pip install --no-cache-dir \
    "ray[default]>=2.54.0" \
    boto3 tqdm httpx \
    beautifulsoup4 langchain langchain-text-splitters neo4j "qdrant-client>=1.17.0" \
    python-docx "opendataloader-pdf>=2.5.5" "PyMuPDF>=1.24.0" "fastembed>=0.8.0" "pyarrow>=18.0.0" \
    pydantic pydantic-settings redis

# FastEmbed's ONNX model cache — must persist across job runs via the
# volume mounted at this path in docker-compose.yaml, or every ingestion
# job re-downloads embedding models from scratch.
ENV HF_HOME=/home/ray/.cache/huggingface